# Copy this file to a new file named ".env" in the same folder, then fill in
# your real values. Never share or commit .env. The .gitignore already excludes it.

# --- Market data (roic.ai) ---
# From your account settings at roic.ai. Professional covers everything the
# engine does; Individual works with a 300 requests/minute cap and 5 years
# of history.
ROIC_API_KEY=your_roic_key_here

# --- SEC EDGAR identification (required, not a secret) ---
# The SEC requires every automated request to identify the caller with a name
# and contact email, and blocks requests that do not. Use your own.
SEC_USER_AGENT=Your Name your.email@example.com

# --- Anthropic (writes the memo and interprets your email replies) ---
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Model used for the memo and feedback. Check the current model names at
# https://docs.claude.com/en/docs/about-claude/models before changing it.
ANTHROPIC_MODEL=claude-opus-5

# --- Email: the dedicated Gmail the engine sends from and reads replies in ---
ENGINE_EMAIL_ADDRESS=yourname.ideaengine@gmail.com
ENGINE_EMAIL_APP_PASSWORD=your_16_character_app_password
# Where you want the memos delivered (your normal inbox):
RECIPIENT_EMAIL=you@example.com

# --- Mail server settings (defaults are Gmail; usually leave these alone) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
